@model EmployeesManagement.Models.Instrument

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Instrument</h4>
<hr />
<div class="row">
    <div class="col-md-12">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="id" />
            <input type="hidden" asp-for="CreatedById" />
            <input type="hidden" asp-for="CreatedOn" />
            <div class="row">
                <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="TipoInstrumento" class="control-label"></label>
                    <input asp-for="TipoInstrumento" class="form-control" />
                    <span asp-validation-for="TipoInstrumento" class="text-danger"></span>
                </div>
                </div>
                <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="NomeInstrumento" class="control-label"></label>
                    <input asp-for="NomeInstrumento" class="form-control" />
                    <span asp-validation-for="NomeInstrumento" class="text-danger"></span>
                </div>
                </div>
                <div class="col-md-6">
                <div class="form-group">
                    <div class="custom-control custom-checkbox">
                        <input type="checkbox" class="custom-control-input" asp-for="UsaCordas">
                        <label class="custom-control-label" asp-for="UsaCordas">
                            Usa Cordas ?
                        </label>
                    </div>
                    <span asp-validation-for="UsaCordas" class="text-danger"></span>
                </div>
                </div>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}