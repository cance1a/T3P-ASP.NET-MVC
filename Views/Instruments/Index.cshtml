@model IEnumerable<EmployeesManagement.Models.Instrument>

@{
    ViewData["Title"] = "Index";
}

<p>
    <a asp-action="Create" class="btn btn-primary"> <i class="fa fa-plus"></i> Add New Instrument</a>
</p>
<div class="card">
    <div class="card-header">
        <h3 class="card-title">Instruments List</h3>
    </div>
    <!-- /.card-header -->
    <div class="card-body">
        <table id="example1" class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.InstrumentType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InstrumentName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UseRopes)
            </th>
            <th>
                Edit
            </th>
            <th>
                View
            </th>
            <th>
                Delete
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.InstrumentType)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.InstrumentName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UseRopes)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.id" class="btn btn-info btn-sm"><i class="fa fa-pen"></i></a>
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@item.id" class="btn btn-success btn-sm"><i class="fa fa-eye"></i></a>
            </td>
            <td>
                <a asp-action="Delete" asp-route-id="@item.id" class="btn btn-danger btn-sm"><i class="fa fa-trash"></i></a>
            </td>
        </tr>
}
    </tbody>
</table>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}